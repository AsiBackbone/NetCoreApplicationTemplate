{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "*/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "**/toc.yml",
          "articles/**/*.md",
          "adr/**/*.md",
          "api/index.md",
          "api/**/*.yml"
        ]
      },
      {
        "src": "api-pages",
        "files": [
          "**/*.md"
        ],
        "dest": "api"
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "public/**",
          "examples/**"
        ]
      }
    ],
    "dest": "_site",
    "sitemap": {
      "baseUrl": "https://asibackbone.github.io/NetCoreApplicationTemplate/",
      "changefreq": "weekly"
    },
    "template": [
      "default",
      "modern",
      "templates"
    ],
    "globalMetadata": {
      "_lang": "en",
      "_appName": ".NET Core Application Template",
      "_appTitle": ".NET Core Application Template",
      "_appLogoPath": "images/logo-docs.png",
      "_appFaviconPath": "images/favicon.ico",
      "_appFooter": "<span>Part of <a href=\"https://asibackbone.github.io/\">AsiBackbone</a> · <a href=\"https://github.com/AsiBackbone/NetCoreApplicationTemplate\">Source</a> · <a href=\"https://github.com/orgs/AsiBackbone/discussions\">Community</a> · <a href=\"https://github.com/AsiBackbone/NetCoreApplicationTemplate/blob/main/LICENSE.txt\">License</a> · <a href=\"https://doi.org/10.5281/zenodo.20373042\">Archive (DOI)</a> · Made with <a href=\"https://dotnet.github.io/docfx\">DocFX</a></span>",
      "_enableSearch": true,
      "_canonicalBaseUrl": "https://asibackbone.github.io/NetCoreApplicationTemplate/",
      "_structuredDataSiteName": ".NET Core Application Template",
      "_structuredDataSiteDescription": "Documentation for the .NET Core Application Template, a secure-by-default ASP.NET Core application scaffold.",
      "_structuredDataPublisherName": "AsiBackbone",
      "_structuredDataPublisherUrl": "https://github.com/AsiBackbone",
      "_socialImageUrl": "https://asibackbone.github.io/NetCoreApplicationTemplate/images/social-preview.png",
      "_socialImageType": "image/png",
      "_socialImageWidth": "640",
      "_socialImageHeight": "320",
      "_socialImageAlt": ".NET Core Application Template — a secure-by-default ASP.NET Core starting point"
    }
  }
}
